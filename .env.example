# CoinGlass API key (https://www.coinglass.com/pricing). Without it the app still runs
# on Binance public data only (live prices, RSI, kline-derived CVD / net delta).
CG_API_KEY=

# hobbyist | startup | standard | professional
# Sets the request budget and which endpoints are used.
#   hobbyist : 30 req/min, history intervals >= 4h, no aggregated CVD / netflow list
#   startup  : 80 req/min, history intervals >= 30m, adds aggregated futures + spot CVD and netflow list
#   standard+: adds the all-coins RSI list; much faster per-coin sweeps
CG_PLAN=hobbyist

# Optional overrides
# PORT=8787
# UNIVERSE_SIZE=200
# CG_EXCHANGES=Binance,OKX,Bybit
# CG_BUDGET=0.8          # share of the plan rate limit this app may use
# CG_INTERVAL=4h         # history interval (hobbyist min 4h, startup min 30m)
# CG_TTL_MS=             # refresh period of the hottest coins; colder coins are 2x and 4x
# BINANCE_RPM=300
# PRICE_REFRESH_MS=4000
